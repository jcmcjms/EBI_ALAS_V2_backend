{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<DB_HOST>;Database=ALASv2_DB;User Id=<DB_USER>;Password=<DB_PASSWORD>;TrustServerCertificate=True",
    "WebLoanConnection": "Server=<DB_HOST>;Database=webloan;User Id=<DB_USER>;Password=<DB_PASSWORD>;TrustServerCertificate=True"
  },
  "Jwt": {
    "SecretKey": "<JWT_SECRET_KEY_MIN_32_CHARS>",
    "Issuer": "EBI.ALAS.V2",
    "Audience": "EBI.ALAS.V2.Frontend",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "AbsoluteSessionExpiryDays": 14
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
